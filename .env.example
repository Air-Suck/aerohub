# Copy to .env and set local device/network paths. Shell-compatible values.
HDC_BIN=/path/to/ohos-sdk/toolchains/hdc
HDC_TARGET=your-device-id
PC_IP=192.168.100.1
ROBOPI_IP=192.168.100.11
PC_INTERFACE=enp129s0
ROBOPI_INTERFACE=eth1
ROS_DOMAIN_ID=83
ROBOPI_ROOT=/data/aerohub/as2
OHOS_SYSDEPS=/path/to/ros-target/deps/out
AS2_MAX_RSS_MB=1536
OHOS_BUILDER_IMAGE=voxelsky/ohos-ros-humble-builder@sha256:3312006a50a2a7f4a26e1c92afcfbb0fd2296989b7e6d22e71b1f77caad0d25f
OHOS_WORK_ROOT=log/airsim/ohos-as2
FLIGHT_BOARD_IMAGE=flight_board:v0.1.0
ONBOARD_COMPUTER_IMAGE=onboard_computer:v0.1.0
FLIGHT_BOARD_CAMERAS=1
# Houmo migration reuses this OHOS Native SDK (read-only inside houmo-migrate-<model>).
OHOS_NATIVE_SDK=/path/to/ohos-sdk/native
HOUMO_MIGRATE_IMAGE=harbor.houmo.ai/toolchain/release:Dadao-xh2-v1.5.0-ubuntu24.04-x86.64
# Existing OHOS/AArch64 TCIM development package for the board runner and TCIM Python binding.
TCIM_RUNTIME_PATH=/path/to/tcim
