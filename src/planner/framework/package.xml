<?xml version="1.0"?>
<package format="3">
  <name>uav_planner_framework</name>
  <version>0.1.0</version>
  <description>Registry, lifecycle, and output gateway for interchangeable UAV planners.</description>
  <maintainer email="noah@example.com">noah</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>as2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>uav_planner_interfaces</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
