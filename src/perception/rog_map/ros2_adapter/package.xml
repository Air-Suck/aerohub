<?xml version="1.0"?>
<package format="3">
  <name>uav_rog_map</name>
  <version>0.1.0</version>
  <description>Independent AeroHub ROS 2 Adapter for the locked ROG-Map core.</description>
  <maintainer email="maintainers@aerohub.invalid">AeroHub maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>rog_map</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>uav_rog_map_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
