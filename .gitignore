# Per-task resolved configs and logs are generated.
# Retain the curated final verification report, configs and evidence logs.
/artifacts/resolved/*
!/artifacts/resolved/.gitkeep
!/artifacts/resolved/*.md
!/artifacts/resolved/final-cat-resolved.yaml
!/artifacts/resolved/final-swarm-resolved.yaml
!/artifacts/resolved/final-cat-planner.log
!/artifacts/resolved/final-cat-takeoff.log
!/artifacts/resolved/final-swarm-planner.log
!/artifacts/resolved/final-swarm-takeoff.log
!/artifacts/resolved/final-runtime-build.log

# Curated historical SUPER flight evidence; other runtime logs stay ignored.
!/demos/super_forest/board-final.log
!/demos/super_forest/mission.log
!/demos/super_forest/px4-final-state.log

# vendor/ is optional local input for rebuilding the retained Dockerfile.
# Runtime images are delivered separately; source archives are not shipped.
# Keep project documentation, references, task YAML, manifests and test fixtures.

artifacts/
vendor/

# Machine-specific AirSim launch profiles
/config/airsim/*.local.json
/config/resources.local.yaml
