<?xml version="1.0"?>
<package format="3">
  <name>uav_as2_setpoint_adapter</name>
  <version>0.1.0</version>
  <description>Translate fleet-local PX4 NED setpoints to Aerostack2 motion references.</description>
  <maintainer email="noah@example.com">noah</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>as2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>uav_planner_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
