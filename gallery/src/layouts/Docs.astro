---
import Base from './Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../lib/algorithms';
interface Props { entry: CollectionEntry<'docs'> }
const { entry } = Astro.props;
const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const href = (id: string) => sitePath(id === 'quickstart' ? 'quickstart/' : `docs/${id}/`);
const { Content, headings } = await render(entry);
const position = entries.findIndex((item) => item.id === entry.id);
const previous = entries[position - 1];
const next = entries[position + 1];
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="docs-layout">
    <aside class="docs-sidebar" aria-label="文档导航">
      <a href={sitePath('docs/')}><strong>文档中心</strong></a>
      {['开始使用', '用户指南', '深入了解'].map((section) => <section>
        <h2>{section}</h2>
        <ul>{entries.filter((item) => item.data.section === section).map((item) => <li>
          <a href={href(item.id)} aria-current={item.id === entry.id ? 'page' : undefined}>{item.data.title}</a>
        </li>)}</ul>
      </section>)}
    </aside>
    <div class="docs-content">
      <p class="eyebrow">{entry.data.section} · {entry.data.status}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      {entry.data.status === '待完善' && <p class="docs-note">本页已建立阅读入口，完整操作教程仍在补充。当前可用资料见下方链接，运行条件与验收范围以对应组件文档为准。</p>}
      {headings.some((heading) => heading.depth === 2) && <nav class="docs-toc" aria-label="本页目录"><ul>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
      <article class="prose"><Content /></article>
      <nav class="docs-pagination" aria-label="文档翻页">
        {previous && <a href={href(previous.id)}>← {previous.data.title}</a>}
        {next && <a href={href(next.id)}>{next.data.title} →</a>}
      </nav>
    </div>
  </div>
</Base>
