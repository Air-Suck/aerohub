---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { integrationLabels, validationLabels } from '../../lib/algorithms';
export async function getStaticPaths() {
  return (await getCollection('algorithms')).map((algorithm) => ({
    params: { id: algorithm.id }, props: { algorithm },
  }));
}
interface Props { algorithm: CollectionEntry<'algorithms'> }
const { algorithm } = Astro.props;
const { data } = algorithm;
const { Content } = await render(algorithm);
---
<Base title={data.title} description={data.summary}>
  <p class="eyebrow">{data.category}</p>
  <h1>{data.title}</h1>
  <p class="lead">{data.summary}</p>
  <dl>
    <dt>迁移状态</dt><dd>{integrationLabels[data.integration]}</dd>
    <dt>验证记录</dt><dd>{validationLabels[data.validation]}</dd>
    <dt>源码来源</dt><dd><a href={data.source}>上游仓库</a></dd>
    <dt>源码版本</dt><dd>{data.revision ?? '尚未登记'}</dd>
  </dl>
  <article class="prose"><Content /></article>
  {data.evidence.length > 0 && <section><h2>验证证据</h2><ul>{data.evidence.map((item) => <li><a href={item.url}>{item.label}</a></li>)}</ul></section>}
</Base>
