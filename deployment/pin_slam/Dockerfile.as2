ARG BASE_IMAGE=onboard_computer:main-e2e
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /opt/pin_slam_as2_ws
COPY src/state_estimator/pin_slam/plugin/ src/uav_pin_slam/
RUN source /opt/ros/humble/setup.bash \
    && source /root/aerostack2_ws/install/setup.bash \
    && colcon build --merge-install --packages-select uav_pin_slam \
      --cmake-args -DCMAKE_BUILD_TYPE=Release
CMD ["bash", "-lc", "source /opt/ros/humble/setup.bash && source /root/aerostack2_ws/install/setup.bash && source /opt/pin_slam_as2_ws/install/setup.bash && exec ros2 launch uav_pin_slam pin_slam.launch.py"]
