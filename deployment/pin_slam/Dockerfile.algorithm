ARG BASE_IMAGE=onboard_computer_dependencies:humble-px4-1.18-msgfix
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cu124 \
      torch==2.5.1+cu124
COPY deployment/pin_slam/requirements.lock /tmp/pin-slam-requirements.lock
RUN python3 -m pip install --no-cache-dir -r /tmp/pin-slam-requirements.lock

WORKDIR /opt/pin_slam_ws
COPY src/state_estimator/pin_slam/upstream/ /opt/pin_slam
COPY src/state_estimator/pin_slam/ros2_adapter/ src/uav_pin_slam_ros2/
RUN source /opt/ros/humble/setup.bash \
    && colcon build --merge-install --packages-select uav_pin_slam_ros2

ENV PIN_SLAM_ROOT=/opt/pin_slam
ENV PYTHONPATH=/opt/pin_slam
ENV PYTHONUNBUFFERED=1
CMD ["bash", "-lc", "source /opt/ros/humble/setup.bash && source /opt/pin_slam_ws/install/setup.bash && exec ros2 run uav_pin_slam_ros2 pin_slam_node --ros-args -r __ns:=/${PIN_SLAM_NAMESPACE:-drone0} --params-file /config/algorithm.yaml"]
