+
+void PixhawkPlatform::finishOffboardRequest(bool success, const std::string & reason)
+{
+  if (offboard_prestream_timer_) {offboard_prestream_timer_->cancel();}
+  offboard_prestream_ready_ = false;
+  auto service = std::move(pending_offboard_service_);
+  auto header = std::move(pending_offboard_request_);
+  if (!header) {return;}
+  if (!rclcpp::ok(this->get_node_base_interface()->get_context())) {return;}
+  std_srvs::srv::SetBool::Response response;
+  response.success = success;
+  response.message = reason;
+  try {
+    service->send_response(*header, response);
+  } catch (const std::exception & error) {
+    RCLCPP_WARN(this->get_logger(), "Offboard response unavailable: %s", error.what());
+  }
+}
+
+void PixhawkPlatform::requestOffboard(
+  OffboardService::SharedPtr service,
+  std::shared_ptr<rmw_request_id_t> header,
+  std::shared_ptr<std_srvs::srv::SetBool::Request> request)
+{
+  // All callbacks remain in the default mutually-exclusive group. The timer
+  // yields between publications, so odometry/info/alerts remain schedulable.
+  if (!request->data || getOffboardMode() || pending_offboard_request_ || offboard_inhibited_) {
+    std_srvs::srv::SetBool::Response response;
+    response.success = false;
+    response.message = !request->data ? "Manual mode is not allowed" :
+      "Offboard is active, pending, or inhibited by an emergency";
+    service->send_response(*header, response);
+    return;
+  }
+  pending_offboard_service_ = service;
+  pending_offboard_request_ = header;
+  offboard_started_armed_ = getArmingState();
+  offboard_prestream_started_ = std::chrono::steady_clock::now();
+  offboard_last_publication_ = offboard_prestream_started_;
+  offboard_prestream_samples_ = 0;
+  px4_offboard_control_mode_ = px4_msgs::msg::OffboardControlMode();
+  px4_offboard_control_mode_.body_rate = true;
+  resetRatesSetpoint();
+  offboard_prestream_timer_->reset();
+}
+
+void PixhawkPlatform::tickOffboardPrestream()
+{
+  if (!pending_offboard_request_) {return;}
+  const auto now = std::chrono::steady_clock::now();
+  if ((offboard_started_armed_ && !getArmingState()) ||
+    now - offboard_prestream_started_ > std::chrono::seconds(3) ||
+    now - offboard_last_publication_ > std::chrono::milliseconds(500))
+  {
+    finishOffboardRequest(false, "Offboard prestream interrupted or timed out");
+    return;
+  }
+  PX4publishRatesSetpoint();
+  offboard_last_publication_ = now;
+  ++offboard_prestream_samples_;
+  if (offboard_prestream_samples_ < 120 ||
+    now - offboard_prestream_started_ < std::chrono::milliseconds(1200)) {return;}
+  offboard_prestream_ready_ = true;
+  const bool success = this->setOffboardControl(true);
+  finishOffboardRequest(success, success ? "Offboard request sent" : "Offboard request rejected");
 }
 
