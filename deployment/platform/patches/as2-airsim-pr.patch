diff --git a/pixi.toml b/pixi.toml
index 41e6f715..b06ba87e 100644
--- a/pixi.toml
+++ b/pixi.toml
@@ -4,34 +4,18 @@ authors = ["Alvaro Gaona <alvgaona@gmail.com>"]
 channels = ["conda-forge"]
 name = "aerostack2"
 platforms = [
-  "linux-64",
-  "linux-aarch64",
+  { platform = "linux-64", glibc = "2.34" },
+  { platform = "linux-aarch64", glibc = "2.34" },
   "osx-arm64"
 ]
 version = "1.1.3"
 
-[system-requirements]
-libc = { family = "glibc", version = "2.34" }
-
 # pin: libcxx 23 removed std::wstring_convert, still used by rosidl_runtime_cpp
 # headers. Drop when ROS or conda-forge ships a fix.
 [workspace.target.osx-arm64.build-variants]
 c_compiler_version = ["22"]
 cxx_compiler_version = ["22"]
 
-[tasks]
-clean = "rm -rf build/ install/ log/"
-test-pkg = "sh -c 'colcon test --packages-up-to \"$0\" --event-handlers console_direct+'"
-test-result = "colcon test-result --verbose"
-# Docker compose wrappers (see docker/compose.yaml)
-"docker:build" = "docker compose -f docker/compose.yaml build"
-"docker:build-humble" = "docker compose -f docker/compose.yaml build humble"
-"docker:build-nightly" = "docker compose -f docker/compose.yaml --profile nightly build nightly-humble"
-"docker:build-jazzy" = "docker compose -f docker/compose.yaml build jazzy"
-"docker:run" = "docker run -it --rm aerostack2/humble"
-"docker:pull" = "docker compose -f docker/compose.yaml --profile nightly pull humble nightly-humble"
-"docker:clean" = "sh -c 'docker image rm -f aerostack2/humble aerostack2/nightly-humble aerostack2/jazzy || true'"
-
 [dependencies]
 aerostack2 = { path = "./aerostack2" }
 
@@ -48,14 +32,22 @@ channels = ["robostack-humble"]
 [feature.humble.dependencies]
 ros-humble-ros2cli = ">=0.18.17,<0.19"
 ros-humble-ros2pkg = ">=0.18.17,<0.19"
-# pin: pixi-build-ros >=0.4.1 emits ros2-distro-mutex >=0.9 recipes; only ros-humble-ros-gz-sim
-# 0.244.24+ ships a mutex-0.9 build, which in turn requires libignition-math6 6.16.0_1 (the
-# build that re-shipped the ignition-math6-eigen3 cmake config previously dropped on osx-arm64).
-ros2-distro-mutex = "0.9.*"
-ros-humble-ros-gz-sim = ">=0.244.24"
-libignition-math6 = { version = ">=6.16.0", build = "*_1" }
+
+[feature.lint]
+channels = ["robostack-humble", "conda-forge"]
+
+[feature.lint.dependencies]
+commitlint = { version = ">=21.2", channel = "conda-forge" }
+lefthook = ">=2.2"
+# Humble's apt uncrustify_vendor ships 0.72; newer releases format differently.
+uncrustify = { version = "0.72.*", channel = "conda-forge" }
+ros-humble-ament-uncrustify = "*"
+ros-humble-ament-cpplint = "*"
+ros-humble-ament-flake8 = "*"
+ros-humble-ament-pep257 = "*"
+ros-humble-ament-xmllint = "*"
 
 [environments]
-jazzy = ["jazzy"]
-humble = ["humble"]
 default = ["humble"]
+jazzy = ["jazzy"]
+lint = { features = ["lint"], no-default-feature = true }
