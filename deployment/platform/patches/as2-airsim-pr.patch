+/**
+* @file logging.cpp
+*
+* Formatting of the filter's log lines
+*
+* @authors Rodrigo Da Silva Gómez
+*/
+
+#include "simple_ekf_core/logging.hpp"
+
+#include <cstdarg>
+#include <cstdio>
+#include <string>
+
+namespace simple_ekf_core
+{
+
+void Logger::log(LogLevel level, const char * format, ...) const
+{
+  if (!sink_) {
+    return;
+  }
+
+  va_list arguments;
+  va_start(arguments, format);
+  va_list measuring;
+  va_copy(measuring, arguments);
+  const int length = std::vsnprintf(nullptr, 0, format, measuring);
+  va_end(measuring);
+
+  std::string line;
+  if (length > 0) {
+    line.resize(static_cast<std::size_t>(length));
+    // C++17 strings are contiguous and keep room for the terminator vsnprintf writes
+    std::vsnprintf(line.data(), line.size() + 1, format, arguments);
+  }
+  va_end(arguments);
+
+  sink_(level, line);
+}
+
+}  // namespace simple_ekf_core
