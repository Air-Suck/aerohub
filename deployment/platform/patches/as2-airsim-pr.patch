+
+  EXPECT_NO_THROW(
+  {
+    mocap_pub->publish(msg);
+    spinSome(exec, 5);
+    // Publish the same message a second time — its stamp does not advance, so it should be
+    // rejected regardless of reject_repeated_positions
+    mocap_pub->publish(msg);
+    spinSome(exec, 5);
