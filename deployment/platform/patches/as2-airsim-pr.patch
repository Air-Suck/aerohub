+/**
+* @file nominal_remap.cpp
+*
+* @brief Remap of camera frames from a calibrated camera to a nominal one
+*/
+
+#include "as2_usb_camera_interface/nominal_remap.hpp"
+
+#include <cmath>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
