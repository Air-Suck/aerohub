<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Keep the shared image's UDP transport policy; change only the inference
       request/reply writers' recovery cadence, never the application deadlines.
       Fast DDS 2.6 XML DataWriter Times and ROS 2 mangled service names:
       https://fast-dds.docs.eprosima.com/en/2.6.x/fastdds/xml_configuration/datawriter.html
       https://fast-dds.docs.eprosima.com/en/2.x/fastdds/ros2/ros2_configure.html -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>diffphys_udp</transport_id><type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize><receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="diffphys" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>diffphys_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <data_writer profile_name="rq/drone0/inference/diffphys/inferRequest">
    <times>
      <heartbeatPeriod><sec>0</sec><nanosec>20000000</nanosec></heartbeatPeriod>
      <nackResponseDelay><sec>0</sec><nanosec>1000000</nanosec></nackResponseDelay>
    </times>
  </data_writer>
  <data_writer profile_name="rr/drone0/inference/diffphys/inferReply">
    <times>
      <heartbeatPeriod><sec>0</sec><nanosec>20000000</nanosec></heartbeatPeriod>
      <nackResponseDelay><sec>0</sec><nanosec>1000000</nanosec></nackResponseDelay>
    </times>
  </data_writer>
</profiles>
