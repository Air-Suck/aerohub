ARG ROS1_BASE=osrf/ros:noetic-desktop-full-focal@sha256:f138c82f326f179e8510eb03f40ee7ccaf16538e5577ab8550af74c4e12616de
FROM ${ROS1_BASE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG UBUNTU_APT_MIRROR=https://archive.ubuntu.com/ubuntu
ARG UBUNTU_SECURITY_MIRROR=https://security.ubuntu.com/ubuntu
ARG ROS_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros/ubuntu
COPY vendor/ros-archive-keyring-2026.asc /tmp/ros-archive-keyring.asc
RUN echo '4a91c49af0d6f0016108b93698782b596c27ccd836937e18e0e36c3347dc602f  /tmp/ros-archive-keyring.asc' \
      | sha256sum -c - \
    && gpg --dearmor --yes --output /usr/share/keyrings/ros-archive-keyring.gpg \
      /tmp/ros-archive-keyring.asc \
    && find /etc/apt -type f -name '*.list' -print0 \
      | xargs -0 sed -i -E \
        's#^deb (\[[^]]*\] )?[^ ]+ (focal|jammy) main$#deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] '"${ROS_APT_MIRROR}"' \2 main#'
RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 \
    | xargs -0 sed -i \
      -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_APT_MIRROR}|g" \
      -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_SECURITY_MIRROR}|g" \
      -e "s|http://snapshots.ros.org/noetic/final/ubuntu|${ROS_APT_MIRROR}|g" \
      -e "s|http://packages.ros.org/ros/ubuntu|${ROS_APT_MIRROR}|g"
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential cmake patch python3-msgpack python3-numpy \
      libboost-thread-dev libeigen3-dev libopencv-dev libpcl-dev \
      ros-noetic-cmake-modules ros-noetic-cv-bridge ros-noetic-eigen-conversions \
      ros-noetic-image-transport ros-noetic-pcl-ros \
    && rm -rf /var/lib/apt/lists/*
COPY vendor/Sophus-79830a1.tar.gz vendor/rpg_vikit-6c886c8.tar.gz /tmp/deps/
RUN echo 'e248fa4543695e07cea30b283eec3968f03732bb0d36eedebbd414939b8a6330  /tmp/deps/Sophus-79830a1.tar.gz' | sha256sum -c - \
    && echo '8162d0b616c443118a52e654394d3eb0807d6dac3b782f4dc3d6823c8815fede  /tmp/deps/rpg_vikit-6c886c8.tar.gz' | sha256sum -c - \
    && mkdir -p /opt/sophus /opt/fast_livo_ws/src \
    && tar -xzf /tmp/deps/Sophus-79830a1.tar.gz --strip-components=1 -C /opt/sophus \
    && tar -xzf /tmp/deps/rpg_vikit-6c886c8.tar.gz -C /opt/fast_livo_ws/src
COPY deployment/fast_livo2/sophus/ /opt/sophus/
RUN patch --batch -p1 -d /opt/sophus < /opt/sophus/complex.patch \
    && cmake -S /opt/sophus -B /opt/sophus/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/sophus/build -j2 && cmake --install /opt/sophus/build && ldconfig
COPY src/basic_function/state_estimator/fast_livo2/upstream/ /opt/fast_livo_ws/src/fast_livo/
COPY deployment/fast_livo2/imu-output.patch /tmp/imu-output.patch
RUN patch --batch -p1 -d /opt/fast_livo_ws/src/fast_livo < /tmp/imu-output.patch
WORKDIR /opt/fast_livo_ws
RUN source /opt/ros/noetic/setup.bash && catkin_make -j2 -DCMAKE_BUILD_TYPE=Release
COPY src/basic_function/state_estimator/fast_livo2/ros1_proxy/output_bridge.py /opt/fast_livo_ws/src/fast_livo/scripts/output_bridge.py
COPY src/basic_function/state_estimator/fast_livo2/ros1_proxy/airsim_input_bridge.py /opt/fast_livo_ws/src/fast_livo/scripts/airsim_input_bridge.py
COPY simulator/airsim/sensors/uav_as2_sensor_adapter/rpc.py /opt/fast_livo_ws/src/fast_livo/scripts/airsim_rpc.py
COPY deployment/fast_livo2/mapping.launch /opt/fast_livo_ws/src/fast_livo/launch/as2_mapping.launch
COPY deployment/fast_livo2/airsim.yaml deployment/fast_livo2/camera_airsim.yaml /opt/fast_livo_ws/src/fast_livo/config/
RUN chmod +x src/fast_livo/scripts/output_bridge.py src/fast_livo/scripts/airsim_input_bridge.py
ENV ROS_MASTER_URI=http://127.0.0.1:11331 ROS_IP=127.0.0.1
CMD ["bash", "-lc", "source /opt/fast_livo_ws/devel/setup.bash && exec roslaunch -p 11331 fast_livo as2_mapping.launch"]
