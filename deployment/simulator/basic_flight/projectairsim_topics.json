{
  "clock": {
    "topic": "/clock",
    "type": "rosgraph_msgs/msg/Clock"
  },
  "pose": {
    "topic": "/drone0/self_localization/pose",
    "type": "geometry_msgs/msg/PoseStamped"
  },
  "imu": {
    "topic": "/ProjectAirsim/SceneBasicDrone/robots/Drone1/sensors/IMU1/imu",
    "type": "sensor_msgs/msg/Imu"
  },
  "rgb": {
    "topic": "/ProjectAirsim/SceneBasicDrone/robots/Drone1/sensors/DownCamera/scene_camera",
    "type": "sensor_msgs/msg/Image"
  },
  "depth": {
    "topic": "/ProjectAirsim/SceneBasicDrone/robots/Drone1/sensors/DownCamera/depth_camera",
    "type": "sensor_msgs/msg/Image"
  },
  "camera_info": {
    "topic": "/ProjectAirsim/SceneBasicDrone/robots/Drone1/sensors/DownCamera/scene_camera/camera_info",
    "type": "sensor_msgs/msg/CameraInfo",
    "calibration": true
  },
  "lidar": {
    "topic": "/ProjectAirsim/SceneBasicDrone/robots/Drone1/sensors/lidar1/lidar",
