ARG BASE_IMAGE=onboard_computer_dependencies:humble-px4-1.18-msgfix
ARG PYTORCH_IMAGE=uav/pin-slam:humble
FROM ${PYTORCH_IMAGE} AS pytorch_source

FROM ${BASE_IMAGE} AS runtime_base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pytorch_source /usr/local/ /usr/local/
RUN python3 -c "import torch; assert torch.__version__ == '2.5.1+cu124'"

FROM runtime_base AS builder

ENV CUDA_HOME=/opt/cuda \
    LD_LIBRARY_PATH=/opt/cuda/lib \
    PATH=/opt/cuda/bin:${PATH} \
    TORCH_CUDA_ARCH_LIST=8.9 \
    MAX_JOBS=8
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential bzip2 curl libeigen3-dev ninja-build python3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY deployment/dpv_slam/cuda-build-packages.sha256 /tmp/cuda-build-packages.sha256
RUN mkdir -p /opt/cuda /tmp/cuda-packages \
    && cd /tmp/cuda-packages \
    && while read -r checksum package; do \
         curl --fail --location --continue-at - --retry 20 --retry-all-errors \
           --speed-limit 1024 --speed-time 180 \
           --output "${package}" \
           "https://conda.anaconda.org/nvidia/linux-64/${package}"; \
       done < /tmp/cuda-build-packages.sha256 \
    && sha256sum --check /tmp/cuda-build-packages.sha256 \
    && for package in *.tar.bz2; do tar -xjf "${package}" -C /opt/cuda; done \
    && nvcc --version \
    && rm -rf /tmp/cuda-packages
WORKDIR /opt/dpvo
COPY src/state_estimator/dpv_slam/upstream/ /opt/dpvo/
RUN test -f dpvo/loop_closure/optim_utils.py \
    && install -m 0644 /dev/null dpvo/loop_closure/__init__.py \
    && mkdir -p thirdparty && ln -s /usr/include/eigen3 thirdparty/eigen-3.4.0 \
    && python3 -m pip wheel --no-deps --no-build-isolation -w /wheels .

FROM runtime_base

COPY deployment/dpv_slam/wheelhouse/ /tmp/runtime-wheels/
RUN python3 -m pip install --no-cache-dir --no-index --no-deps \
      /tmp/runtime-wheels/*.whl \
    && rm -rf /tmp/runtime-wheels \
    && python3 -c "import cv2, numba, numpy, pypose, torch, torch_scatter; assert numpy.__version__ == '1.26.4'; assert torch.__version__ == '2.5.1+cu124'"
COPY --from=builder /wheels/*.whl /tmp/wheels/
RUN python3 -m pip install --no-cache-dir /tmp/wheels/*.whl && rm -rf /tmp/wheels

WORKDIR /opt/dpv_slam_ws
COPY src/state_estimator/dpv_slam/ros2_adapter/ src/uav_dpv_slam_ros2/
RUN source /opt/ros/humble/setup.bash \
    && colcon build --merge-install --packages-select uav_dpv_slam_ros2

COPY src/state_estimator/dpv_slam/upstream/config/default.yaml /opt/dpv_slam/default.yaml
COPY deployment/dpv_slam/models/dpvo.pth /opt/dpv_slam/dpvo.pth
ENV DPVO_ROOT=/opt/dpvo
CMD ["bash", "-lc", "source /opt/ros/humble/setup.bash && source /opt/dpv_slam_ws/install/setup.bash && exec ros2 run uav_dpv_slam_ros2 dpv_slam_node --ros-args -r __ns:=/${DPV_SLAM_NAMESPACE:-drone0} --params-file /config/algorithm.yaml"]
