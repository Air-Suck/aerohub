+TEST(Magnetometer, ConfiguredWorldFieldRotatesIntoBodyFrame) {
+  auto config = projectairsim::Robot::GetBasicMagnetometerConfig();
+  config["magnetic-field-ned-gauss"] = "0.18 0.05 0.49";
+  config["noise-sigma"] = "0 0 0";
+  config["noise-bias"] = "0 0 0";
+  auto sensor = projectairsim::Robot::MakeMagnetometer("Magnetometer1", true, "ParentLink");
+  projectairsim::Robot::LoadMagnetometer(sensor, config);
+  projectairsim::Kinematics kinematics;
+  projectairsim::Environment environment;
+  projectairsim::Robot::InitializeMagnetometer(sensor, kinematics, environment);
+  sensor.Update(1000000, 1000000);
+  auto field = sensor.getOutput().getData()["magnetic_field_body"];
+  EXPECT_NEAR(field["x"].get<float>(), 0.18f, 1e-6f);
+  EXPECT_NEAR(field["y"].get<float>(), 0.05f, 1e-6f);
+  EXPECT_NEAR(field["z"].get<float>(), 0.49f, 1e-6f);
+  kinematics.pose.orientation = projectairsim::Quaternion(
+      Eigen::AngleAxisf(1.57079632679f, projectairsim::Vector3::UnitZ()));
+  sensor.Update(2000000, 1000000);
+  field = sensor.getOutput().getData()["magnetic_field_body"];
+  EXPECT_NEAR(field["x"].get<float>(), 0.05f, 1e-6f);
+  EXPECT_NEAR(field["y"].get<float>(), -0.18f, 1e-6f);
+  EXPECT_NEAR(field["z"].get<float>(), 0.49f, 1e-6f);
+}
+
+TEST(Magnetometer, RejectsZeroConfiguredWorldField) {
+  auto config = projectairsim::Robot::GetBasicMagnetometerConfig();
+  config["magnetic-field-ned-gauss"] = "0 0 0";
+  auto sensor = projectairsim::Robot::MakeMagnetometer("Magnetometer1", true, "ParentLink");
+  EXPECT_ANY_THROW(projectairsim::Robot::LoadMagnetometer(sensor, config));
+}
